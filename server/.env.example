PORT=3001
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=shelfsense
# Comma-separated list of exact browser origins allowed by CORS
CLIENT_ORIGIN=http://localhost:5173
# Shared demo secret; the browser user types it into the access screen. Min 16 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DEMO_ACCESS_TOKEN=
# IANA timezone used to decide what "today" is for expiry maths (e.g. Asia/Karachi)
APP_TIMEZONE=UTC
# Optional integration test database (must be a throwaway cluster/DB; tests use shelfsense_test_* names)
MONGODB_URI_TEST=
